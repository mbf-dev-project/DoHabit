// Config docs: https://developers.cloudflare.com/pages/functions/wrangler-configuration/
{
	"name": "mayweather-habits",
	"pages_build_output_dir": "dist",
	"compatibility_date": "2026-06-18",
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "mayweather-habits-db",
			"database_id": "9918779e-67be-4812-b68a-25e8756409b0",
			"migrations_dir": "migrations"
		}
	],
	"env": {
		"production": {
			"compatibility_date": "2026-06-18",
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "mayweather-habits-db",
					"database_id": "9918779e-67be-4812-b68a-25e8756409b0",
					"migrations_dir": "migrations"
				}
			]
		}
	}
}